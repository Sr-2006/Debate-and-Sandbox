{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentReadyV1",
  "description": "Canonical JSON Schema for autosre.incident.ready.v1 Stage A envelope delivered from Laptop 1 to Laptop 2.",
  "type": "object",
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "root_event_id",
    "correlation_id",
    "incident_id",
    "phase",
    "component",
    "status",
    "timestamp",
    "source",
    "integrity",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"]
    },
    "event_type": {
      "type": "string",
      "enum": ["autosre.incident.ready.v1"]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_event_id": {
      "type": ["string", "null"]
    },
    "root_event_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["laptop1"]
        },
        "host": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "dataset_version": {
          "type": ["string", "null"]
        },
        "git_sha": {
          "type": ["string", "null"]
        },
        "generated_at": {
          "type": ["string", "null"]
        }
      }
    },
    "metrics": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "integrity": {
      "type": "object",
      "required": ["payload_sha256"],
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sanitized": {
          "type": ["boolean", "null"]
        },
        "signature": {
          "type": ["string", "null"]
        },
        "commit_sha": {
          "type": ["string", "null"]
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "system_context",
        "incident_event",
        "infrastructure_topology",
        "service_health_status",
        "telemetry_evidence",
        "injected_chaos_context"
      ],
      "additionalProperties": false,
      "properties": {
        "system_context": {
          "type": "object"
        },
        "incident_event": {
          "type": "object",
          "required": ["incident_id"],
          "properties": {
            "incident_id": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string"
            },
            "priority_score": {
              "type": "number"
            },
            "occurrence_count": {
              "type": "integer"
            },
            "target_service": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "infrastructure_topology": {
          "type": "object"
        },
        "service_health_status": {
          "type": "object"
        },
        "telemetry_evidence": {
          "type": "object"
        },
        "injected_chaos_context": {
          "type": "object"
        },
        "laptop1_rl_advisory": {
          "type": ["object", "null"]
        },
        "lineage_metadata": {
          "type": ["object", "null"]
        },
        "phase1_summary": {
          "type": ["object", "null"]
        },
        "phase2_summary": {
          "type": ["object", "null"]
        }
      }
    }
  }
}
