{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RLFeatureContextV2",
  "type": "object",
  "required": [
    "incident",
    "phase3",
    "target",
    "safety",
    "evidence",
    "history"
  ],
  "properties": {
    "incident": {
      "type": "object",
      "properties": {
        "severity": { "type": ["string", "null"], "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL", null] },
        "occurrence_count": { "type": ["integer", "null"] },
        "priority_score": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "phase3": {
      "type": "object",
      "properties": {
        "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "uncertainty": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "agent_valid_ratio": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "agreement": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "evidence_grounding": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "resolved": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "violation": { "type": "boolean" },
        "requires_human_approval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "quality_score": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "sample_size": { "type": "integer", "minimum": 0 },
        "success_lower_bound": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "attestation_success_rate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "verification_success_rate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
