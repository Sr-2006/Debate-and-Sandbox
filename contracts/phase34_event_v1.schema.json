{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase34EventV1",
  "type": "object",
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "verification_run_id",
    "problem_run_id",
    "case_id",
    "phase",
    "component",
    "event",
    "status",
    "reason_code",
    "duration_ms",
    "details"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["phase34-event-v1"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "verification_run_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "INPUT",
        "PHASE_3",
        "PHASE_3_TO_4_HANDOFF",
        "RL_ADVISORY",
        "PHASE_4",
        "LEARNING",
        "REPORTING"
      ]
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": ["string", "null"]
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "details": {
      "type": "object"
    }
  }
}
