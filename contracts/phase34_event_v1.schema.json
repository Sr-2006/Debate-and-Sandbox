{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase34EventV1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "run_id",
    "case_id",
    "timestamp",
    "phase",
    "step",
    "status",
    "reason_code",
    "reason",
    "payload",
    "integrity_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["phase34-event-v1"]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "enum": [
        "PHASE_3",
        "PHASE_3_TO_4_HANDOFF",
        "RL_ADVISORY",
        "PHASE_4",
        "LEARNING",
        "FINAL_SUMMARY",
        "INTEGRITY"
      ]
    },
    "step": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "reason_code": {
      "type": ["string", "null"]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object"
    },
    "integrity_hash": {
      "type": ["string", "null"]
    }
  }
}
